<template>
	<!-- 名片卡片：点击发起单聊 -->
	<view v-if="card != null" class="card" @click="onCardClick">
		<view class="card__head">
			<em-avatar :src="card.avatarUrl" :name="card.nickname" :size="40" />
			<view class="card__head-text">
				<text class="card__name">{{ card.nickname }}</text>
				<text class="card__id">{{ t('demo.chat.contactCard.idPrefix') }}{{ card.userId }}</text>
			</view>
		</view>
		<view class="card__foot">
			<em-icon name="person-card" :size="12" class="card__foot-icon" />
			<text class="card__foot-text">{{ t('demo.chat.contactCard.label') }}</text>
		</view>
	</view>

	<!-- 未知自定义消息：占位气泡（与 uikit 默认回落一致） -->
	<view v-else class="card__fallback">
		<text class="card__fallback-text">{{ t('message.custom') }}</text>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'
	import { useLocale } from '@/uni_modules/easemob-uikit-uni/libs'
	import type { EmMessageItem } from '@/uni_modules/easemob-uikit-uni/libs'
	import { contactCardOf } from '@/common/demo-cards'

	// #custom-message 插槽：按 customEvent 分发 demo 卡片（名片），未知事件回落占位气泡
	interface Props {
		message: EmMessageItem
	}

	const props = defineProps<Props>()

	const emit = defineEmits<{
		(e: 'open-card', userId: string): void
	}>()

	defineOptions({ styleIsolation: 'app-and-page' })

	const { t } = useLocale()

	const card = computed(() => contactCardOf(props.message))

	function onCardClick(): void {
		if (card.value != null) {
			emit('open-card', card.value.userId)
		}
	}
</script>

<style>
	.card {
		width: 240px;
		background-color: var(--em-bubble-bg-other);
		border-radius: var(--em-bubble-radius, 16px);
		padding: 12px;
		display: flex;
		flex-direction: column;
	}

	.card__head {
		flex-direction: row;
		align-items: center;
	}

	.card__head-text {
		margin-left: 10px;
		display: flex;
		flex-direction: column;
	}

	.card__name {
		font-size: 15px;
		font-weight: 500;
		line-height: 20px;
		color: var(--em-bubble-text-other);
	}

	.card__id {
		font-size: 12px;
		line-height: 17px;
		color: var(--em-text-tertiary);
	}

	.card__foot {
		flex-direction: row;
		align-items: center;
		margin-top: 10px;
		padding-top: 8px;
		border-top-width: 0.5px;
		border-top-style: solid;
		border-top-color: var(--em-border-color);
	}

	.card__foot-icon {
		color: var(--em-text-tertiary);
		margin-right: 4px;
	}

	.card__foot-text {
		font-size: 11px;
		color: var(--em-text-tertiary);
	}

	.card__fallback {
		padding: 10px 12px;
		border-radius: var(--em-bubble-radius, 16px);
		background-color: var(--em-bubble-bg-other);
	}

	.card__fallback-text {
		font-size: 15px;
		line-height: 22px;
		color: var(--em-bubble-text-other);
	}
</style>
