<template>
	<view class="page" :class="themeClass">
		<em-conversation-page
			:show-connection-banner="uikitFeatures.conversationConnectionBanner"
			:show-search="uikitFeatures.conversationSearch"
			:show-tabs="uikitFeatures.conversationTabs"
			@select="onSelect"
			@menu="onMenu"
		/>
	</view>
</template>

<script setup lang="ts">
	import { onShow } from '@dcloudio/uni-app'
	import { watch } from 'vue'
	import { CONVERSATION_MENU_KEY, conversationStore, EmKit, useLocale, useTabBarBadge, useThemeChrome } from '@/uni_modules/easemob-uikit-uni/libs'
	import type { ConversationTypeValue } from '@/uni_modules/easemob-uikit-uni/libs'
	import { syncTabBarLocale } from '@/common/locale/index'
	import { fillMissingProfiles } from '@/common/profile-provider'
	import { uikitFeatures } from '@/common/uikit-feature-state'

	// 原生 tabBar 深色跟随：onShow + 主题变化时同步 uni.setTabBarStyle / H5 tabbar DOM
	const { themeClass } = useThemeChrome({
		tabBarPages: [
			'pages/conversation/conversation',
			'pages/contact/contact',
			'pages/settings/settings',
		],
	})

	const badges = useTabBarBadge({ conversationIndex: 0, contactIndex: 1 })
	const { t } = useLocale()

	// 多端互踢：在最近一个会话插本地系统灰条（insertLocalNotice 仅本地、不落服务端），并 toast 提示
	let kickedNoticed = false
	watch(
		() => EmKit.state.kicked,
		(kicked) => {
			if (kicked !== true || kickedNoticed) return
			kickedNoticed = true
			const top = conversationStore.items[0]
			if (top != null) {
				EmKit.insertLocalNotice(top.conversationId, top.chatType, t('demo.conversation.kickedNotice'))
			}
			uni.showToast({ title: t('demo.conversation.kickedNotice'), icon: 'none' })
		}
	)

	onShow(() => {
		// 未登录只看 userId：断网重连时 status 会短暂离开 online，不能用作守卫
		if (EmKit.state.userId === '') {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		// 组件默认 autoSync=true，首次挂载自拉；从聊天页返回的补同步由页面 onShow 负责
		EmKit.syncConversations().catch(() => {})
		// 同步后补齐缺昵称/头像的用户资料（注入兜底展示值，不覆盖 SDK 已有资料）
		fillMissingProfiles()
		// 从聊天页/二级页返回时补同步角标（原生 setTabBarBadge 要求当前页是 tab 页）
		badges.sync()
		// 登录后首次进入 tab 页：把持久化语言应用到原生 tabBar 文案（守卫内跳过非 tab 页）
		syncTabBarLocale()
	})

	// 预热：跳转动画期间数据已在路上，聊天页打开即有缓存可渲染
	function onSelect(conversationId: string, chatType: ConversationTypeValue): void {
		EmKit.enterConversation(conversationId, chatType).catch(() => {})
		EmKit.loadHistory(conversationId, chatType).catch(() => {})
		uni.navigateTo({ url: `/sub-im/pages/chat/chat?conversationId=${conversationId}&chatType=${chatType}` })
	}

	// new-chat / pin / mute / delete 由页面组件内置；create-group 跳群列表页（建群弹窗在群页内）
	function onMenu(key: string): void {
		if (key === CONVERSATION_MENU_KEY.CREATE_GROUP) {
			uni.navigateTo({ url: '/sub-im/pages/group/group' })
		}
	}
</script>

<style>
	@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
		background-color: var(--em-conversation-list-bg);
	}
</style>
