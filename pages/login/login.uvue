<template>
	<view class="login" :style="{ paddingTop: safeTop + 'px' }">
		<view class="login__glow login__glow--pink" />
		<view class="login__glow login__glow--core" />

		<!-- 启动屏：凭证检查/自动登录期间只渲染 splash，登录表单绝不闪现 -->
		<view v-if="splashVisible" class="login__splash">
			<image class="login__splash-logo" src="/static/logo.png" mode="aspectFit" />
		</view>

		<template v-else>
		<view class="login__brand" @click="openHome">
			<image class="login__brand-logo" src="/static/brand-logo.svg" mode="aspectFit" />
		</view>

		<scroll-view class="login__scroll" scroll-y>
			<view class="login__content">
				<view class="login__card">
					<view class="login__shimmer login__shimmer--top" />
					<button class="login__dev-entry" :class="{ 'login__dev-entry--active': devEnabled }" @click="onDevTap">{{ DEV_ICON }}</button>

					<view class="login__body">
						<view class="login__titles">
							<text class="login__subtitle">{{ t('demo.login.welcome') }}</text>
							<image class="login__title-logo" src="/static/logo.png" mode="aspectFit" />
							<text class="login__tagline">EASEMOB IM DEMO · FOR VUE</text>
						</view>

						<view v-if="devEnabled" class="login__dev-config">
							<view class="login__dev-divider">
								<view class="login__dev-line" />
								<text class="login__dev-divider-text">{{ t('demo.login.devConfig') }}</text>
								<view class="login__dev-line" />
							</view>

							<view class="login__dev-row">
								<text class="login__dev-row-label">{{ t('demo.login.persistConfig') }}</text>
								<em-switch v-model="persistEnabled" custom-style="--em-switch-off-bg: rgba(255, 255, 255, 0.12); --em-primary-color: rgba(0, 158, 255, 0.85);" @change="onPersistChange" />
							</view>

							<view class="login__dev-row">
								<text class="login__dev-row-label">{{ t('demo.login.customAppKey') }}</text>
							</view>

							<view class="login__dev-field">
								<text class="login__dev-label">{{ t('demo.login.appKey') }}</text>
								<input
									class="login__input"
									:class="{ 'login__input--focused': focused === 'devAppKey' }"
									v-model="devAppKey"
									placeholder="xxxx#xxxx"
									placeholder-style="color: #b0bec5"
									cursor-color="#009eff"
									@focus="onFocus('devAppKey')"
									@blur="onBlur"
								/>
							</view>

							<view class="login__dev-row">
								<text class="login__dev-row-label">{{ t('demo.login.privateServer') }}</text>
								<em-switch v-model="usePrivateServer" custom-style="--em-switch-off-bg: rgba(255, 255, 255, 0.12); --em-primary-color: rgba(0, 158, 255, 0.85);" />
							</view>

							<template v-if="usePrivateServer">
								<view class="login__dev-field">
									<text class="login__dev-label">{{ t('demo.login.imServer') }}</text>
									<input
										class="login__input"
										:class="{ 'login__input--focused': focused === 'devIm' }"
										v-model="devImServer"
										placeholder="im-api-v2.easemob.com"
										placeholder-style="color: #b0bec5"
										cursor-color="#009eff"
										@focus="onFocus('devIm')"
										@blur="onBlur"
									/>
								</view>
								<view class="login__dev-field">
									<text class="login__dev-label">{{ t('demo.login.restServer') }}</text>
									<input
										class="login__input"
										:class="{ 'login__input--focused': focused === 'devRest' }"
										v-model="devRestServer"
										placeholder="a1.easemob.com"
										placeholder-style="color: #b0bec5"
										cursor-color="#009eff"
										@focus="onFocus('devRest')"
										@blur="onBlur"
									/>
								</view>
							</template>

							<view class="login__dev-actions">
								<button class="login__dev-save" :class="{ 'login__dev-save--success': devSaveState === 'success', 'login__dev-save--error': devSaveState === 'error' }" @click="onDevSave">
									{{ devSaveText }}
								</button>
								<button class="login__dev-exit" @click="onDevExit">{{ t('demo.login.devExit') }}</button>
							</view>

							<view class="login__dev-divider login__dev-divider--light">
								<view class="login__dev-line login__dev-line--light" />
								<text class="login__dev-divider-text login__dev-divider-text--light">{{ t('demo.login.loginDivider') }}</text>
								<view class="login__dev-line login__dev-line--light" />
							</view>
						</view>

						<view class="login__form">
							<template v-if="devEnabled">
								<input
									class="login__input login__input--standalone"
									:class="{ 'login__input--focused': focused === 'userId' }"
									v-model="userId"
									:placeholder="t('demo.login.userIdPlaceholder')"
									placeholder-style="color: #b0bec5"
									cursor-color="#009eff"
									@focus="onFocus('userId')"
									@blur="onBlur"
								/>
								<input
									class="login__input login__input--standalone"
									:class="{ 'login__input--focused': focused === 'token' }"
									v-model="token"
									:placeholder="t('demo.login.tokenPlaceholder')"
									placeholder-style="color: #b0bec5"
									cursor-color="#009eff"
									@focus="onFocus('token')"
									@blur="onBlur"
								/>
							</template>
							<template v-else>
								<view class="login__phone" :class="{ 'login__phone--focused': focused === 'phone' }">
									<text class="login__phone-prefix">+86</text>
									<view class="login__phone-divider" />
									<input
										class="login__phone-input"
										v-model="phone"
										type="tel"
										:placeholder="t('demo.login.phonePlaceholder')"
										placeholder-style="color: #b0bec5"
										cursor-color="#009eff"
										maxlength="11"
										@focus="onFocus('phone')"
										@blur="onBlur"
									/>
								</view>

								<view class="login__sms-row">
									<view class="login__sms-input-wrap" :class="{ 'login__sms-input-wrap--focused': focused === 'sms' }">
										<input
											class="login__sms-input"
											v-model="smsCode"
											type="text"
											inputmode="numeric"
											:placeholder="t('demo.login.smsPlaceholder')"
											placeholder-style="color: #b0bec5"
											cursor-color="#009eff"
											maxlength="6"
											@focus="onFocus('sms')"
											@blur="onBlur"
										/>
									</view>
									<button
										class="login__sms-btn"
										:class="{ 'login__sms-btn--disabled': !canSendSms }"
										:disabled="!canSendSms"
										@click="onGetSms"
									>{{ smsButtonText }}</button>
								</view>
							</template>

							<text v-if="displayError !== ''" class="login__error">{{ displayError }}</text>
							<text v-if="noticeText !== ''" class="login__notice">{{ noticeText }}</text>

							<button class="login__submit" :class="{ 'login__submit--busy': loginLoading }" :disabled="loginLoading" @click="onLogin">
								{{ loginLoading ? t('demo.login.loggingIn') : t('demo.login.loginNow') }}
							</button>

							<view v-if="!devEnabled" class="login__terms">
								<view class="login__checkbox-hit" @click="toggleAgreement">
									<view class="login__checkbox" :class="{ 'login__checkbox--checked': agreed }">
										<text class="login__checkbox-mark">{{ agreed ? '✓' : '' }}</text>
									</view>
								</view>
								<view class="login__terms-content">
									<text class="login__terms-text">{{ t('demo.login.termsPrefix') }}</text>
									<text class="login__terms-link" @click="openTerms">{{ t('demo.login.termsService') }}</text>
									<text class="login__terms-text login__terms-text--plain">{{ t('demo.login.termsAnd') }}</text>
									<text class="login__terms-link" @click="openPrivacy">{{ t('demo.login.privacyTitle') }}</text>
								</view>
							</view>
						</view>
					</view>
					<view class="login__shimmer login__shimmer--bottom" />
				</view>
			</view>
		</scroll-view>

		</template>

		<view class="login__footer" :style="{ paddingBottom: (24 + safeBottom) + 'px' }">
			<text class="login__footer-copyright">{{ t('demo.login.copyright') }}</text>
			<text class="login__footer-version">{{ t('demo.login.versionLine', { sdk: '5.2.0', uikit: UIKIT_VERSION, demo: demoVersion }) }}</text>
			<text v-if="devEnabled" class="login__logs-entry" @click="openLogs">{{ t('demo.login.logsEntry') }}</text>
		</view>

		<view v-if="logsVisible" class="login__logs-panel">
			<view class="login__logs-header" :style="{ paddingTop: safeTop + 'px' }">
				<text class="login__logs-title">{{ t('demo.login.logsTitle') }}</text>
				<button class="login__logs-close" @click="logsVisible = false">{{ t('demo.login.logsClose') }}</button>
			</view>
			<scroll-view class="login__logs-scroll" scroll-y>
				<text class="login__logs-text">{{ logText === '' ? t('demo.login.logsEmpty') : logText }}</text>
			</scroll-view>
			<view class="login__logs-actions" :style="{ paddingBottom: (12 + safeBottom) + 'px' }">
				<button class="login__logs-copy" :class="{ 'login__logs-copy--disabled': logText === '' }" :disabled="logText === ''" @click="copyLogs">
					{{ t('demo.login.logsCopy') }}
				</button>
			</view>
		</view>

		<em-popup :visible="agreementVisible" position="center" :mask-closable="false">
			<view class="login__agreement-dialog">
				<text class="login__agreement-title">{{ t('demo.login.agreementTitle') }}</text>
				<view class="login__agreement-content">
					<text class="login__agreement-text">{{ t('demo.login.agreementContentPrefix') }}</text>
					<text class="login__agreement-link" @click="openTerms">{{ t('demo.login.termsService') }}</text>
					<text class="login__agreement-text">{{ t('demo.login.termsAnd') }}</text>
					<text class="login__agreement-link" @click="openPrivacy">{{ t('demo.login.privacyTitle') }}</text>
					<text class="login__agreement-text">{{ t('demo.login.agreementContentSuffix') }}</text>
				</view>
				<view class="login__agreement-actions">
					<view class="login__agreement-action" @click="onAgreementCancel">
						<text class="login__agreement-action-text">{{ t('demo.login.agreementDecline') }}</text>
					</view>
					<view class="login__agreement-action" @click="onAgreementConfirm">
						<text class="login__agreement-action-text login__agreement-action-text--confirm">{{ t('demo.login.agreementAccept') }}</text>
					</view>
				</view>
			</view>
		</em-popup>

		<LoginSmsCaptcha
			:visible="smsCaptchaVisible"
			:phone="phone"
			:title="t('demo.login.captchaTitle')"
			:cancel-text="t('demo.login.captchaCancel')"
			:error-text="t('demo.login.captchaLoadFailed')"
			:locale="getLocale()"
			:scene-id="CAPTCHA_SCENE_ID"
			:prefix="CAPTCHA_PREFIX"
			:secret="CAPTCHA_SECRET"
			@verified="onSmsCaptchaVerified"
			@cancel="onSmsCaptchaCancel"
			@error="onSmsCaptchaError"
		/>
	</view>
</template>

<script setup lang="ts">
	import { loginByPhone, mapLoginSmsError, mapPhoneLoginError, sendLoginSms } from '@/common/auth-api'
	import { clearPhoneCredentials, getPhoneCredentials, savePhoneCredentials, clearLoginCredentials, getLoginCredentials, saveLoginCredentials } from '@/common/account-state'
	import { getDemoVersion } from '@/common/app-version'
	import { CAPTCHA_PREFIX, CAPTCHA_SCENE_ID, CAPTCHA_SECRET, DEFAULT_APP_KEY } from '@/common/config'
	import { tokenExpiredHandler, tokenWillExpireHandler } from '@/common/token-renewal'
	import { DevConfig, getDevConfig, getEffectiveAppKey, getPersistEnabled, setDevConfig, setPersistEnabled } from '@/common/dev-config'
	import { EmKit, getLogLevel, UIKIT_VERSION, useLocale, createLogger, checkNetworkOnce, subscribeNetworkStatus } from '@/uni_modules/easemob-uikit-uni/libs'
	import EmPopup from '@/uni_modules/easemob-uikit-uni/components/em-popup/em-popup'
	import LoginSmsCaptcha from '@/pages/login/login-sms-captcha'

	type PendingAgreementAction = 'sms' | 'login'

	const { t, getLocale } = useLocale()
	const loginLogger = createLogger('login')

	const DEV_ICON = '</>'
	const demoVersion = getDemoVersion()
	const windowInfo = uni.getWindowInfo()
	const safeTop = windowInfo.safeAreaInsets?.top ?? 0
	const safeBottom = windowInfo.safeAreaInsets?.bottom ?? 0

	const phone = ref('')
	const smsCode = ref('')
	const agreed = ref(false)
	const agreementVisible = ref(false)
	const pendingAgreementAction = ref<PendingAgreementAction | null>(null)
	const focused = ref('')
	const loginLoading = ref(false)
	const networkOnline = ref<boolean | null>(null)
	const errorText = ref('')
	const noticeText = ref('')
	const logsVisible = ref(false)
	const logText = ref('')

	const userId = ref('')
	const token = ref('')
	const devEnabled = ref(false)
	const devTapCount = ref(0)
	// 启动屏门控：setup 先于首帧渲染执行，初始 true 保证登录表单在凭证检查完成前不被绘制
	const splashVisible = ref(true)

	const persistEnabled = ref(true)
	const usePrivateServer = ref(false)
	const devAppKey = ref('')
	const devImServer = ref('')
	const devRestServer = ref('')
	const devSaveState = ref('idle')
	const displayError = computed((): string => networkOnline.value === false ? t('demo.login.networkOffline') : errorText.value)
	const devSaveText = computed((): string => {
		if (devSaveState.value === 'success') return t('demo.login.devSaved')
		if (devSaveState.value === 'error') return t('demo.login.devSaveError')
		return t('demo.login.devSave')
	})

	const smsCountdown = ref(0)
	const smsLoading = ref(false)
	const smsCaptchaVisible = ref(false)
	let smsTimer: number | null = null
	let devResetTimer: number | null = null
	let devSaveTimer: number | null = null
	let stopNetworkWatch: (() => void) | null = null

	const canSendSms = computed((): boolean => phone.value.length === 11 && smsCountdown.value === 0 && !smsLoading.value)
	const smsButtonText = computed((): string => {
		if (smsLoading.value) return t('demo.login.smsSending')
		if (smsCountdown.value > 0) return `${smsCountdown.value}s`
		return t('demo.login.smsGet')
	})

	function openLogs(): void {
		logText.value = EmKit.getLogText()
		logsVisible.value = true
	}

	function copyLogs(): void {
		const text = EmKit.getLogText()
		logText.value = text
		if (text === '') return
		try {
			uni.setClipboardData({
				data: text,
				showToast: false,
				success: () => {
					uni.showToast({ title: t('demo.login.logsCopySuccess'), icon: 'none' })
				},
				fail: () => {
					uni.showToast({ title: t('demo.login.logsCopyFailed'), icon: 'none' })
				}
			})
		} catch (e) {
			uni.showToast({ title: t('demo.login.logsCopyFailed'), icon: 'none' })
		}
	}

	async function refreshNetworkStatus(): Promise<boolean | null> {
		const online = await checkNetworkOnce()
		if (online !== null) networkOnline.value = online
		return online
	}

	async function ensureNetworkAvailable(): Promise<boolean> {
		return await refreshNetworkStatus() !== false
	}

	onMounted(() => {
		loginLogger.info('login page mounted')
		stopNetworkWatch = subscribeNetworkStatus((online) => {
			networkOnline.value = online
		})
		const config = getDevConfig()
		devAppKey.value = config.appKey
		devImServer.value = config.imServer
		devRestServer.value = config.restServer
		usePrivateServer.value = config.usePrivateServer
		persistEnabled.value = getPersistEnabled()
		userId.value = config.devUserId
		token.value = config.devToken
		void tryAutoLogin()
	})

	// 免输入自动登录：进程内已登录直接进首页；有持久化凭证则直连 SDK（期间保持启动屏），
	// 失败清凭证落在登录表单并展示原因；无凭证直接亮出登录表单（与 vue3 demo 的 AppInitializer 同思路）
	async function tryAutoLogin(): Promise<void> {
		if (EmKit.state.userId !== '') {
			loginLogger.info('auto login skipped: active session')
			uni.reLaunch({ url: '/pages/conversation/conversation' })
			return
		}
		const creds = getLoginCredentials()
		if (creds == null) {
			loginLogger.info('auto login skipped: no credentials')
			void refreshNetworkStatus()
			splashVisible.value = false
			return
		}
		const start = Date.now()
		loginLogger.info('auto login started')
		loginLoading.value = true
		try {
			if (!await ensureNetworkAvailable()) {
				loginLogger.info('auto login skipped: system offline')
				splashVisible.value = false
				return
			}
			const appkey = getPhoneCredentials() != null ? DEFAULT_APP_KEY : getEffectiveAppKey()
			await loginIm(creds.userId, creds.token, appkey)
		} catch (error: any) {
			logLoginError('auto login failed:', error, [creds.userId, creds.token])
			clearLoginCredentials()
			await refreshNetworkStatus()
			errorText.value = networkOnline.value === false ? '' : errorMessage(error)
			splashVisible.value = false
		} finally {
			loginLogger.info('auto login finished:', `${Date.now() - start}ms`)
			loginLoading.value = false
		}
	}

	onUnmounted(() => {
		stopNetworkWatch?.()
		stopNetworkWatch = null
		clearSmsTimer()
		clearDevResetTimer()
		clearDevSaveTimer()
	})

	function onFocus(field: string) {
		focused.value = field
	}

	function onBlur() {
		focused.value = ''
	}

	function clearSmsTimer() {
		if (smsTimer != null) {
			clearInterval(smsTimer)
			smsTimer = null
		}
	}

	function startSmsCountdown() {
		clearSmsTimer()
		smsCountdown.value = 60
		smsTimer = setInterval(() => {
			smsCountdown.value -= 1
			if (smsCountdown.value <= 0) {
				clearSmsTimer()
				smsCountdown.value = 0
			}
		}, 1000)
	}

	function clearDevResetTimer() {
		if (devResetTimer != null) {
			clearTimeout(devResetTimer)
			devResetTimer = null
		}
	}

	function clearDevSaveTimer() {
		if (devSaveTimer != null) {
			clearTimeout(devSaveTimer)
			devSaveTimer = null
		}
	}

	function isValidAppKey(value: string): boolean {
		return /^[^#\s]+#[^#\s]+$/.test(value.trim())
	}

	function onPersistChange(value: boolean) {
		setPersistEnabled(value)
	}

	function onDevSave() {
		const appKey = devAppKey.value.trim()
		const imServer = devImServer.value.trim()
		const restServer = devRestServer.value.trim()
		if (!isValidAppKey(appKey)) {
			devSaveState.value = 'error'
		} else if (usePrivateServer.value && (imServer === '' || restServer === '')) {
			devSaveState.value = 'error'
		} else {
			devSaveState.value = 'success'
			const existing = getDevConfig()
			setDevConfig(new DevConfig(appKey, imServer, restServer, usePrivateServer.value, existing.devUserId, existing.devToken))
			uni.showToast({ title: t('demo.login.configSaved'), icon: 'none' })
		}
		clearDevSaveTimer()
		devSaveTimer = setTimeout(() => {
			devSaveState.value = 'idle'
			devSaveTimer = null
		}, devSaveState.value === 'success' ? 2500 : 2000)
	}

	function onDevExit() {
		devEnabled.value = false
		devTapCount.value = 0
		clearDevResetTimer()
		clearDevSaveTimer()
		devSaveState.value = 'idle'
		errorText.value = ''
		noticeText.value = ''
	}

	function onDevTap() {
		if (devEnabled.value) {
			devEnabled.value = false
			devTapCount.value = 0
			errorText.value = ''
			noticeText.value = ''
			return
		}
		devTapCount.value += 1
		if (devTapCount.value >= 7) {
			devEnabled.value = true
			devTapCount.value = 0
			clearDevResetTimer()
			errorText.value = ''
			noticeText.value = ''
			uni.showToast({ title: t('demo.login.devModeEntered'), icon: 'none' })
			return
		}
		clearDevResetTimer()
		devResetTimer = setTimeout(() => {
			devTapCount.value = 0
			devResetTimer = null
		}, 3000)
		if (devTapCount.value > 4) {
			uni.showToast({ title: t('demo.login.devTapHint', { count: 7 - devTapCount.value }), icon: 'none' })
		}
	}

	function toggleAgreement() {
		agreed.value = !agreed.value
	}

	function requestAgreement(action: PendingAgreementAction): void {
		pendingAgreementAction.value = action
		agreementVisible.value = true
	}

	function onAgreementCancel(): void {
		agreementVisible.value = false
		pendingAgreementAction.value = null
	}

	function onAgreementConfirm(): void {
		const action = pendingAgreementAction.value
		if (action == null) return
		agreed.value = true
		agreementVisible.value = false
		pendingAgreementAction.value = null
		if (action === 'sms') {
			// #ifdef APP-HARMONY
			setTimeout(() => onGetSms(), 0)
			return
			// #endif
			onGetSms()
		} else {
			void onLogin()
		}
	}

	function errorMessage(error: any): string {
		if (error instanceof Error) return error.message
		return t('demo.login.requestFailed')
	}

	function logLoginError(stage: string, error: any, credentials: string[] = []): void {
		let message = errorMessage(error)
		const sensitiveValues = [phone.value, userId.value, token.value, smsCode.value, ...credentials]
		for (const value of sensitiveValues) {
			const sensitive = value.trim()
			if (sensitive !== '') message = message.split(sensitive).join('[redacted]')
		}
		loginLogger.error(stage, message)
	}

	function validPhone(): boolean {
		return /^1[3-9]\d{9}$/.test(phone.value)
	}

	async function onGetSms(): Promise<void> {
		errorText.value = ''
		noticeText.value = ''
		if (!validPhone()) {
			errorText.value = t('demo.login.invalidPhone')
			return
		}
		if (!canSendSms.value) return
		if (!agreed.value) {
			requestAgreement('sms')
			return
		}
		if (CAPTCHA_SCENE_ID === '' || CAPTCHA_PREFIX === '' || CAPTCHA_SECRET === '') {
			errorText.value = t('demo.login.captchaConfigMissing')
			return
		}
		if (!await ensureNetworkAvailable()) return
		smsCaptchaVisible.value = true
	}

	function onSmsCaptchaCancel() {
		smsCaptchaVisible.value = false
	}

	function onSmsCaptchaError(message: string) {
		smsCaptchaVisible.value = false
		errorText.value = message
	}

	async function onSmsCaptchaVerified(captchaVerifyParam: string) {
		if (!smsCaptchaVisible.value || smsLoading.value || smsCountdown.value > 0) return
		smsCaptchaVisible.value = false
		errorText.value = ''
		noticeText.value = ''
		smsLoading.value = true
		try {
			if (!await ensureNetworkAvailable()) return
			await sendLoginSms(phone.value, captchaVerifyParam)
			startSmsCountdown()
			noticeText.value = t('demo.login.smsSentNotice')
		} catch (error: any) {
			await refreshNetworkStatus()
			errorText.value = networkOnline.value === false ? '' : mapLoginSmsError(errorMessage(error))
		} finally {
			smsLoading.value = false
		}
	}

	async function loginIm(id: string, credential: string, appkey: string): Promise<void> {
		if (appkey === '') {
			throw new Error(t('demo.login.needAppKey'))
		}
		const start = Date.now()
		if (EmKit.state.appkey !== '' && EmKit.state.appkey !== appkey) {
			loginLogger.info('IM appkey changed, logout previous session')
			try {
				await EmKit.logout()
			} catch (e) {}
		}
		loginLogger.info('IM init requested:', appkey)
		// sdkLogLevel 取 WARN：鸿蒙上 SDK 的 DEBUG 日志会命中 ArkTS 限制打断会话同步
		EmKit.init({
			appkey,
			enableReadReceipt: true,
			logLevel: getLogLevel(),
			sdkLogLevel: 'WARN',
			onTokenWillExpire: tokenWillExpireHandler,
			onTokenExpired: tokenExpiredHandler
		})
		loginLogger.info('IM login started')
		await EmKit.login({ userId: id, token: credential })
		loginLogger.info('IM login succeeded:', `${Date.now() - start}ms`)
		// 免输入自动登录凭证：登录成功即落盘，启动页据此直连
		saveLoginCredentials(id, credential)
		uni.reLaunch({
			url: '/pages/conversation/conversation',
			success: () => loginLogger.info('conversation navigation succeeded'),
			fail: (error) => loginLogger.error('conversation navigation failed:', error)
		})
	}

	async function onLogin() {
		if (loginLoading.value) return
		errorText.value = ''
		noticeText.value = ''
		if (devEnabled.value) {
			if (userId.value.trim() === '' || token.value.trim() === '') {
				errorText.value = t('demo.login.needUserToken')
				return
			}
			loginLoading.value = true
			try {
				if (!await ensureNetworkAvailable()) return
				const config = getDevConfig()
				setDevConfig(new DevConfig(config.appKey, config.imServer, config.restServer, config.usePrivateServer, userId.value.trim(), token.value.trim()))
				clearLoginCredentials()
				// userId/token 登录不支持注销账户，清除可能残留的手机号凭证
				clearPhoneCredentials()
				loginLogger.info('developer login started')
				await loginIm(userId.value.trim(), token.value.trim(), getEffectiveAppKey())
			} catch (error: any) {
				logLoginError('developer login failed:', error)
				await refreshNetworkStatus()
				errorText.value = networkOnline.value === false ? '' : errorMessage(error)
			} finally {
				loginLoading.value = false
			}
			return
		}
		if (!agreed.value) {
			requestAgreement('login')
			return
		}
		if (!validPhone()) {
			errorText.value = t('demo.login.invalidPhone')
			return
		}
		if (smsCode.value.trim() === '') {
			errorText.value = t('demo.login.smsRequired')
			return
		}
		loginLoading.value = true
		try {
			if (!await ensureNetworkAvailable()) return
			const start = Date.now()
			loginLogger.info('phone login started')
			const result = await loginByPhone(phone.value, smsCode.value)
			loginLogger.info('App Server login succeeded:', `${Date.now() - start}ms`)
			clearLoginCredentials()
			// 注销账户依赖手机号 + chatToken，登录成功后落盘
			savePhoneCredentials(phone.value, result.token)
			await loginIm(result.chatUserName, result.token, DEFAULT_APP_KEY)
		} catch (error: any) {
			logLoginError('phone login failed:', error)
			await refreshNetworkStatus()
			errorText.value = networkOnline.value === false ? '' : mapPhoneLoginError(errorMessage(error), phone.value)
		} finally {
			loginLoading.value = false
		}
	}

	function openPage(url: string, title: string) {
		uni.navigateTo({ url: `/pages/webview/webview?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}` })
	}

	function openHome() {
		openPage('https://www.easemob.com', t('demo.login.brand'))
	}

	function openTerms() {
		openPage('https://www.easemob.com/demo/agreement', t('demo.login.termsService'))
	}

	function openPrivacy() {
		openPage('https://www.easemob.com/console/privacy', t('demo.login.privacyTitle'))
	}
</script>

