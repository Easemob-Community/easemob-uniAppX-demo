<template>
	<web-view class="webview" :src="url"></web-view>
</template>

<script setup lang="ts">
	import { useLocale } from '@/uni_modules/easemob-uikit-uni/libs'

	const url = ref('')

	const { t } = useLocale()

	function optionText(options: Record<string, any>, key: string, fallback: string): string {
		const value = options[key]
		if (typeof value !== 'string') return fallback
		return decodeURIComponent(value) ?? fallback
	}

	onLoad((options) => {
		const pageOptions = options as Record<string, any>
		url.value = optionText(pageOptions, 'url', '')
		uni.setNavigationBarTitle({ title: optionText(pageOptions, 'title', t('demo.webview.defaultTitle')) })
	})
</script>

<style>
	.webview {
		width: 100%;
		height: 100%;
	}
</style>
