		flex-direction: column;
		height: 100%;
		min-height: 0;
		background-color: var(--em-bg-base);
	}

	.body {
		flex: 1;
		min-height: 0;
		padding: 16px;
	}

	/* banner：圆角卡片、右侧插画、左侧文字内容 */
	.banner {
		position: relative;
		display: flex;
		flex-direction: row;
		height: 140px;
		border-radius: 12px;
		overflow: hidden;
		background-image: linear-gradient(to right, #0b1e46, #1b5bd7);
	}

	.banner-illustration {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 55%;
		opacity: 0.9;
	}

