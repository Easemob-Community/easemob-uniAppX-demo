		display: flex;
		flex-direction: column;
		justify-content: center;
		z-index: 1;
		padding: 16px;
	}

	.banner-title {
		width: 148px;
		height: 42px;
	}

	.banner-slogan {
		margin-top: 8px;
		font-size: var(--em-font-size-12, 12px);
		color: rgba(255, 255, 255, 0.85);
	}

	.banner-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		height: 28px;
		margin-top: 10px;
		padding: 0 14px;
		border-radius: 999px;
		background-color: #ffffff;
	}

	.banner-btn-text {
		font-size: var(--em-font-size-12, 12px);
		font-weight: var(--em-font-weight-medium, 500);
		color: #123a8f;
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 32px;
		padding: 0 8px;
	}

	.welcome {
		font-size: var(--em-font-size-16, 16px);
		font-weight: var(--em-font-weight-medium, 500);
		color: var(--em-text-primary);
	}

	.logo {
		width: 200px;
		height: 29px;
		margin-top: 12px;
	}

	.desc {
		margin-top: 12px;
		font-size: var(--em-font-size-13, 13px);
		color: var(--em-text-secondary);
	}

	.versions {
		display: flex;
		flex-direction: row;
		gap: 12px;
		margin-top: 12px;
	}

	.version-item {
		font-size: var(--em-font-size-12, 12px);
		color: var(--em-text-tertiary);
	}

	/* 联系行 */
	.links {
		display: flex;
		flex-direction: column;
		align-self: stretch;
		margin-top: 32px;
	}

	.link-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 54px;
		border-bottom: 0.5px solid var(--em-border-color);
	}

	.link-label {
		font-size: var(--em-font-size-14, 14px);
		font-weight: var(--em-font-weight-medium, 500);
		color: var(--em-text-primary);
	}

	.link-value {
		font-size: var(--em-font-size-14, 14px);
		color: var(--em-text-secondary);
	}

	.link-value--underline {
		text-decoration: underline;
