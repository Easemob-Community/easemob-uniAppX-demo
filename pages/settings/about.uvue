<template>
	<view class="page" :class="themeClass">
		<em-nav-bar :title="t('demo.settings.menu.about')" @back="onBack" />
		<scroll-view scroll-y class="body">
			<!-- 品牌 banner：插画底 + 标题 / 标语 / 接入按钮 -->
			<view class="banner">
				<image class="banner-illustration" src="/static/about/banner-illustration.jpg" mode="aspectFill" />
				<view class="banner-content">
					<image class="banner-title" src="/static/about/banner-title.png" mode="aspectFit" />
					<text class="banner-slogan">{{ t('demo.settings.about.slogan') }}</text>
					<view class="banner-btn" @click="onRegister">
						<text class="banner-btn-text">{{ t('demo.settings.about.register') }}</text>
					</view>
				</view>
			</view>

			<view class="content">
				<text class="welcome">{{ t('demo.settings.about.welcome') }}</text>
				<image class="logo" :src="logoSrc" mode="aspectFit" />
				<text class="desc">{{ t('demo.settings.about.description') }}</text>

				<view class="versions">
					<text class="version-item">{{ t('demo.settings.about.demoVersion') }}：{{ demoVersion }}</text>
					<text class="version-item">{{ t('demo.settings.about.uikitVersion') }}：{{ uikitVersion }}</text>
					<text class="version-item">{{ t('demo.settings.about.sdkVersion') }}：{{ sdkVersion }}</text>
				</view>

				<view class="links">
					<view class="link-row" @click="onCall">
						<text class="link-label">{{ t('demo.settings.about.phone') }}</text>
						<text class="link-value">400-622-1776</text>
					</view>
					<view class="link-row" @click="onWebsite">
						<text class="link-label">{{ t('demo.settings.about.website') }}</text>
						<text class="link-value link-value--underline">www.easemob.com</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	import { computed, ref } from 'vue'
	import { EmKit, UIKIT_VERSION, useLocale, useTheme } from '@/uni_modules/easemob-uikit-uni/libs'

	const { t } = useLocale()
	const { themeClass, isDark } = useTheme()

	const demoVersion = '1.0.0'
	const uikitVersion = UIKIT_VERSION
	const sdkVersion = ref('-')
	const logoSrc = computed(() => isDark.value ? '/static/about/about-logo-dark.png' : '/static/about/about-logo.png')

	EmKit.getSDKClient().then((client) => {
		sdkVersion.value = client.getVersion()
	}).catch(() => {})

	function onBack(): void {
		uni.navigateBack()
	}

	// 官网 / 注册页经 webview 页打开（承载外部链接与原生导航标题）
	function onRegister(): void {
		uni.navigateTo({ url: '/pages/webview/webview?url=https%3A%2F%2Fconsole.easemob.com%2Fuser%2Fregister%3Futm_source%3Ddemo' })
	}

	function onWebsite(): void {
		uni.navigateTo({ url: '/pages/webview/webview?url=https%3A%2F%2Fwww.easemob.com%2F%3Futm_source%3Ddemo' })
	}

	function onCall(): void {
		uni.makePhoneCall({ phoneNumber: '400-622-1776' })
	}
</script>

<style>
	@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

