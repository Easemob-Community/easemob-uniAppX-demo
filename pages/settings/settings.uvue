<template>
	<view class="page" :class="themeClass">
		<em-nav-bar :title="t('demo.settings.title')" :show-back="false" />
		<scroll-view scroll-y class="body" :style="demoPrimaryColorStyle()">
			<view class="list">
				<view
					v-for="item in menuItems"
					:key="item.key"
					class="item"
					@click="onSelect(item)"
				>
					<em-icon :name="item.icon" :size="24" color="var(--em-text-primary)" />
					<text class="label">{{ item.label }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { EmKit, useLocale, useTabBarBadge, useThemeChrome } from '@/uni_modules/easemob-uikit-uni/libs'
	import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'
	import { syncTabBarLocale } from '@/common/locale/index'
	import { demoPrimaryColorStyle } from '@/common/theme-style'

	const { t } = useLocale()

	const { themeClass } = useThemeChrome({
		tabBarPages: [
			'pages/conversation/conversation',
			'pages/contact/contact',
			'pages/settings/settings',
		],
	})

	const badges = useTabBarBadge({ conversationIndex: 0, contactIndex: 1 })

	interface MenuItem {
		key: string
		label: string
		icon: EmIconName
		url: string
	}

	const menuItems = computed<MenuItem[]>(() => [
		{
			key: 'account',
			label: t('demo.settings.menu.account'),
			icon: 'person-single',
			url: '/pages/settings/account',
		},
		{
			key: 'general',
			label: t('demo.settings.menu.general'),
			icon: 'flower',
			url: '/pages/settings/general',
		},
		{
			key: 'about',
			label: t('demo.settings.menu.about'),
			icon: 'rect-candle',
			url: '/pages/settings/about',
		},
		{
			key: 'features',
			label: t('demo.settings.menu.features'),
			icon: 'console',
			url: '/pages/settings/features',
		},
	])

	onShow(() => {
		if (EmKit.state.userId === '') {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		badges.sync()
		// 从二级页返回时补同步原生 tabBar 文案（守卫内跳过非 tab 页）
		syncTabBarLocale()
	})

	function onSelect(item: MenuItem): void {
		uni.navigateTo({ url: item.url })
	}
</script>

<style>
	@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
		background-color: var(--em-bg-base);
	}

	.body {
		flex: 1;
		min-height: 0;
	}

	/* 菜单列表：左右 8px 内边距、项间距 8px（对齐 vue3 demo 设置页） */
	.list {
		display: flex;
		flex-direction: column;
		padding: 0 8px 8px;
	}

	/* 菜单项：64px 高、24px 图标、14px 文字、圆角 8px */
	.item {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		height: 64px;
		margin-top: 8px;
		padding: 0 12px;
		border-radius: var(--em-component-radius, 8px);
	}

	.label {
		font-size: var(--em-font-size-14, 14px);
		font-weight: var(--em-font-weight-medium, 500);
		color: var(--em-text-primary);
	}
</style>
