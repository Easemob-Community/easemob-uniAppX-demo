	"preloadRule": {
		"pages/login/login": {
			"network": "all",
			"packages": ["sub-sdk"]
		}
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^em-([a-z-]+)-page$": "@/uni_modules/easemob-uikit-uni/components/pages/em-$1-page/em-$1-page.vue",
			"^demo-([a-z-]+)$": "@/sub-im/components/demo-$1/demo-$1.uvue"
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "@navigationBarTextStyle",
		"navigationBarTitleText": "uni-app x",
		"navigationBarBackgroundColor": "@navigationBarBackgroundColor",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "@tabBarColor",
		"selectedColor": "#009EFF",
		"backgroundColor": "@tabBarBackgroundColor",
		"borderStyle": "@tabBarBorderStyle",
		"list": [
			{
				"pagePath": "pages/conversation/conversation",
				"text": "会话",
				"iconPath": "static/tabbar/chat.png",
				"selectedIconPath": "static/tabbar/chat-active.png"
			},
			{
				"pagePath": "pages/contact/contact",
				"text": "通讯录",
				"iconPath": "static/tabbar/contacts.png",
				"selectedIconPath": "static/tabbar/contacts-active.png"
			},
			{
				"pagePath": "pages/settings/settings",
				"text": "设置",
				"iconPath": "static/tabbar/settings.png",
				"selectedIconPath": "static/tabbar/settings-active.png"
			}
		]
	},
